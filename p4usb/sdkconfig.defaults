CONFIG_IDF_TARGET="esp32p4"
# This P4-Pico is a rev v1.3 chip, which v3 builds do not support.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# Console is UART0 on the CH343 USB-C; GPIO 24/25 carry the C5's sample clock and Q7.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n

CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_FREERTOS_HZ=1000

# Frame and JPEG buffers live in the in-package PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y

# UVC on the high-speed port (bottom JST), one MJPEG size at the NTSC frame geometry.
CONFIG_TUSB_MANUFACTURER="C5VRX"
CONFIG_TUSB_PRODUCT="C5VRX Receiver"
CONFIG_UVC_MODE_BULK_CAM1=y
CONFIG_UVC_CAM1_FRAMESIZE_WIDTH=720
CONFIG_UVC_CAM1_FRAMESIZE_HEIGT=480
CONFIG_UVC_CAM1_FRAMERATE=60
CONFIG_UVC_CAM1_MULTI_FRAMESIZE=n
