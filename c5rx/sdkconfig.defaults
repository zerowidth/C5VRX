CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Console is UART0 on GPIO 11/12, wired to the P4. GPIO 13/14 carry I2 and I1,
# so the USB-Serial-JTAG is off; the ROM still offers USB in download mode.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n

CONFIG_FREERTOS_HZ=1000

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Wi-Fi logs would interleave with command replies on the P4's UART.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# Receive-only radio: see main/rf.c and the top-level sdkconfig.defaults.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_TX_BUFFER_TYPE_DYNAMIC=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
CONFIG_IEEE802154_ENABLED=n
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n
CONFIG_ESP_PHY_DISABLE_PLL_TRACK=y
